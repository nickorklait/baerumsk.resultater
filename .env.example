# Copy to .env (git-ignored) and fill in. See README → "Publishing to Instagram".
INSTAGRAM_ACCESS_TOKEN=
# Optional: looked up from the token if empty. NOT the app ID.
INSTAGRAM_USER_ID=
# Optional: captions written by Claude (otherwise template captions are used)
ANTHROPIC_API_KEY=

# Cloud: key for data/instagram-token.enc (also in GitHub Secrets)
TOKEN_ENCRYPTION_KEY=
